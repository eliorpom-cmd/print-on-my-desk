# Secrets, never commit
worker/.dev.vars
worker/.env
agent/config.py
firmware/config.py
bridge/config.js
.env
*.local

# Written by worker/setup.mjs. It holds your admin and printer tokens in plain
# text, on purpose: they have to live somewhere you can find them again, and
# Cloudflare will not show them to you twice.
worker/my-tokens.txt

# Your own word list, once you have written one worth keeping.
# The starter list ships; yours should not.
# worker/src/terms.js

# Written by tools/preview.mjs every time somebody previews a ticket, in the
# directory they ran it from. Not output anybody means to commit.
ticket.png

# Node / Cloudflare
node_modules/
.wrangler/
dist/

# Python
__pycache__/
*.py[cod]
.venv/

# macOS
.DS_Store

# Source fonts: fetched by tools/build_font.py, never committed.
#
# The three presets are all under the SIL Open Font License, so redistributing
# them is allowed - but only WITH their licence text, which this repository
# does not carry. Rather than ship a font without its paperwork, build_font.py
# downloads the one you ask for and tells you where from. What IS committed is
# the atlas it produces: bitmaps of the glyphs you use, not the outlines.
tools/fonts/
